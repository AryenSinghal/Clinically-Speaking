# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (model name is configurable; change if the API rejects it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Vapi
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
# Optional: several Vapi phone number IDs, comma separated. When one hits its daily outbound cap the next is used.
VAPI_PHONE_NUMBER_IDS=
# Public https URL reaching this app (ngrok / cloudflared), used for Vapi webhooks
PUBLIC_URL=
# Optional: override the model Vapi's voice agent uses (defaults to GEMINI_MODEL)
VAPI_LLM_MODEL=
# Safety: all outbound calls are redirected to this number during the demo (E.164). Leave empty to call candidate phones.
DEMO_PHONE_OVERRIDE=

# Optional: custom MapLibre style URL for the recruitment map (e.g. https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY). Leave empty to use free OpenStreetMap tiles (no key).
NEXT_PUBLIC_MAP_STYLE_URL=
